{
  "openapi": "3.1.0",
  "info": {
    "title": "Smart College Surveillance - Alerts API",
    "description": "Sprint 1 slice of the cloud surveillance platform: one camera registry and one alert ingestion endpoint, decoupled from the AI models.",
    "version": "0.1.0-sprint1"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Service banner",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Root  Get"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Liveness and DB check",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/alerts": {
      "post": {
        "tags": [
          "alerts"
        ],
        "summary": "Ingest one alert from an AI service or the health monitor",
        "operationId": "create_alert_api_v1_alerts_post",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertAccepted"
                }
              }
            }
          },
          "200": {
            "description": "Duplicate event_id, already stored (idempotent)."
          },
          "400": {
            "description": "Validation failed (missing or invalid fields)."
          },
          "401": {
            "description": "Missing or invalid X-API-Key."
          }
        }
      },
      "get": {
        "tags": [
          "alerts"
        ],
        "summary": "List / filter alerts (newest first)",
        "operationId": "list_alerts_api_v1_alerts_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(new|confirmed|dismissed)$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "event_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "fight",
                    "smoking",
                    "camera_disconnected",
                    "camera_frozen",
                    "person_handoff"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Event Type"
            }
          },
          {
            "name": "camera_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Camera Id"
            }
          },
          {
            "name": "global_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Global Id"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "From"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "To"
            }
          },
          {
            "name": "min_confidence",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 1,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Min Confidence"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertPage"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/alerts/{event_id}": {
      "get": {
        "tags": [
          "alerts"
        ],
        "summary": "Read one alert",
        "operationId": "read_alert_api_v1_alerts__event_id__get",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Event Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/alerts/{event_id}/status": {
      "patch": {
        "tags": [
          "alerts"
        ],
        "summary": "Operator decision: confirm or dismiss",
        "operationId": "update_status_api_v1_alerts__event_id__status_patch",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Event Id"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-User-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertStatusUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertOut"
                }
              }
            }
          },
          "409": {
            "description": "Alert is already in a final state."
          }
        }
      }
    },
    "/api/v1/cameras": {
      "get": {
        "tags": [
          "cameras"
        ],
        "summary": "List registered cameras",
        "operationId": "list_cameras_api_v1_cameras_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CameraOut"
                  },
                  "type": "array",
                  "title": "Response List Cameras Api V1 Cameras Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "cameras"
        ],
        "summary": "Register a camera (demo helper, admin UI comes later)",
        "operationId": "register_camera_api_v1_cameras_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CameraCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CameraOut"
                }
              }
            }
          },
          "409": {
            "description": "camera_id already registered."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlertAccepted": {
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid",
            "title": "Event Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "confirmed",
              "dismissed"
            ],
            "title": "Status"
          },
          "duplicate": {
            "type": "boolean",
            "title": "Duplicate",
            "description": "True when this event_id had already been stored; the request was ignored."
          },
          "received_at": {
            "type": "string",
            "format": "date-time",
            "title": "Received At"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "status",
          "duplicate",
          "received_at"
        ],
        "title": "AlertAccepted"
      },
      "AlertCreate": {
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid",
            "title": "Event Id",
            "description": "Client-generated UUIDv4/v7. Used as an idempotency key."
          },
          "event_type": {
            "type": "string",
            "enum": [
              "fight",
              "smoking",
              "camera_disconnected",
              "camera_frozen",
              "person_handoff"
            ],
            "title": "Event Type"
          },
          "camera_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Camera Id"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp",
            "description": "When the event happened, ISO-8601 with offset (UTC preferred)."
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "track_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Track Id"
          },
          "global_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Global Id"
          },
          "clip_uri": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024
              },
              {
                "type": "null"
              }
            ],
            "title": "Clip Uri"
          },
          "snapshot_uri": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Uri"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "confirmed",
              "dismissed"
            ],
            "title": "Status",
            "description": "Only 'new' is accepted on creation; operators change it later.",
            "default": "new"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "event_type",
          "camera_id",
          "timestamp",
          "confidence"
        ],
        "title": "AlertCreate",
        "description": "Payload posted by an AI service or the health monitor."
      },
      "AlertOut": {
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid",
            "title": "Event Id"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "fight",
              "smoking",
              "camera_disconnected",
              "camera_frozen",
              "person_handoff"
            ],
            "title": "Event Type"
          },
          "camera_id": {
            "type": "string",
            "title": "Camera Id"
          },
          "camera_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Camera Name"
          },
          "zone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Zone"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "track_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Track Id"
          },
          "global_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Global Id"
          },
          "clip_uri": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clip Uri"
          },
          "snapshot_uri": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Uri"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "confirmed",
              "dismissed"
            ],
            "title": "Status"
          },
          "status_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status By"
          },
          "status_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status At"
          },
          "received_at": {
            "type": "string",
            "format": "date-time",
            "title": "Received At"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "event_type",
          "camera_id",
          "timestamp",
          "confidence",
          "status",
          "received_at"
        ],
        "title": "AlertOut"
      },
      "AlertPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AlertOut"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "AlertPage"
      },
      "AlertStatusUpdate": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "dismissed"
            ],
            "title": "Status"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "AlertStatusUpdate"
      },
      "CameraCreate": {
        "properties": {
          "camera_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Camera Id"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "zone": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Zone"
          },
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "stream_path": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Stream Path"
          },
          "fps_target": {
            "type": "number",
            "maximum": 120.0,
            "exclusiveMinimum": 0.0,
            "title": "Fps Target",
            "default": 25.0
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "camera_id",
          "name",
          "zone",
          "latitude",
          "longitude",
          "stream_path"
        ],
        "title": "CameraCreate"
      },
      "CameraOut": {
        "properties": {
          "camera_id": {
            "type": "string",
            "title": "Camera Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "zone": {
            "type": "string",
            "title": "Zone"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "stream_path": {
            "type": "string",
            "title": "Stream Path"
          },
          "fps_target": {
            "type": "number",
            "title": "Fps Target"
          },
          "status": {
            "type": "string",
            "enum": [
              "online",
              "offline",
              "frozen",
              "unknown"
            ],
            "title": "Status"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "last_seen_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Seen At"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "camera_id",
          "name",
          "zone",
          "latitude",
          "longitude",
          "stream_path",
          "fps_target",
          "status",
          "is_active",
          "created_at"
        ],
        "title": "CameraOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}