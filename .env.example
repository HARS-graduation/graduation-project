# Copy to .env (or export the variables) before running the API.

# Where the demo SQLite file lives (the production DB is PostgreSQL/PostGIS).
ALERTS_DB_PATH=data/alerts.db

# Shared secret for POST /api/v1/alerts. Empty = auth disabled (local dev only).
INGEST_API_KEY=

# Comma-separated origins allowed to call the API from the React app.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Insert the four demo cameras and the camera graph on first start.
SEED_DEMO_CAMERAS=1
